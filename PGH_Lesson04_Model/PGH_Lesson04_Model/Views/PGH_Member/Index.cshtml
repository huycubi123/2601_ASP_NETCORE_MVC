@model IEnumerable<PGH_Lesson04_Model.Models.DataModels.PGH_Member>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-controller="PGH_Member" asp-action="Create">Thêm mới thành viên</a>
</p>
<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MemberId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MemberId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-warning">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-sm btn-info">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </td>
        </tr>
}
    </tbody>
</table>
